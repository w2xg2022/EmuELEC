+
+/* Stub providers for the hci_aml bluetooth node.
+ * The W1 combo die is already powered and clocked via the WiFi path
+ * (pwm_ef 32k, combo supply), so these only satisfy the driver API.
+ */
+/ {
+	bt_lpo_32k: bt-lpo-32k {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <32768>;
+		clock-output-names = "bt_lpo_32k";
+	};
+
+	bt_vddio: bt-vddio {
+		compatible = "regulator-fixed";
+		regulator-name = "bt_vddio";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		regulator-always-on;
+		regulator-boot-on;
+	};
+};

mkdir -p $RELEASE_DIR/3rdparty/bootloader
  if [ -n "$UBOOT_SYSTEM" ]; then
    BOOTLOADER_DIR=$(get_build_dir $BOOTLOADER)
    if [ -f $BOOTLOADER_DIR/idbloader.img ]; then
      cp -a $BOOTLOADER_DIR/idbloader.img $RELEASE_DIR/3rdparty/bootloader
    fi
    if [ -f $BOOTLOADER_DIR/uboot.img ]; then
      cp -a $BOOTLOADER_DIR/uboot.img $RELEASE_DIR/3rdparty/bootloader
    fi
    if [ -f $BOOTLOADER_DIR/trust.img ]; then
      cp -a $BOOTLOADER_DIR/trust.img $RELEASE_DIR/3rdparty/bootloader
    fi
  fi
  
  if [ -f $INSTALL/usr/share/bootloader/boot.ini ]; then
  cp -a $INSTALL/usr/share/bootloader/boot.ini $RELEASE_DIR/3rdparty/bootloader
  fi
 
  LINUX_DTS_DIR=$(get_build_dir linux)/arch/$TARGET_KERNEL_ARCH/boot/dts
  for dtb in $LINUX_DTS_DIR/*.dtb $LINUX_DTS_DIR/*/*.dtb; do
    if [ -f $dtb ]; then
      cp -a $dtb $RELEASE_DIR/3rdparty/bootloader
    fi
  done

  # NOTE(w2xg2022 2026-08-04): ★再从 INSTALL 抓一次 —— 上面那段在云编译常常是空的★
  #
  #   上面只看【内核建置树】(get_build_dir linux)。云编译的接力 checkpoint 为了省空间
  #   会把 build/ 目录剥掉, 於是还原回来的那一轮 $LINUX_DTS_DIR 根本不存在,
  #   一颗 dtb 都抓不到 —— 而这个 for 回圈对「目录不存在」是静默跳过的。
  #
  #   後果: 开机分区没有 dtb, 但 scripts/mkimage 仍写 FDT /rk3566-md1000.dtb。
  #   MD1000 是从 eMMC 链载, 所以机器【照样开得起来】, 坏掉的是 md1000-kernel-sync.sh
  #   ——它要从开机分区根目录取 dtb 同步到 eMMC, 找不到就跳过:
  #   ★KERNEL 更新了、dtb 永远停在旧版, 全程静默★(实机拆 run 30917265669 坐实)。
  #
  #   $INSTALL/usr/share/bootloader/ 是内核套件【安装阶段】放 dtb 的地方,
  #   它跟着 install_pkg 走、不会被 checkpoint 剥掉, 所以拿它当第二来源。
  #   两边都抓是刻意的: 本地全新建置时以内核树为准(最新), 云编译接力时靠 INSTALL 补上。
  for dtb in $INSTALL/usr/share/bootloader/*.dtb; do
    if [ -f $dtb ]; then
      cp -a $dtb $RELEASE_DIR/3rdparty/bootloader
    fi
  done
  
LE_TMP=$(mktemp -d)
mkdir -p "${LE_TMP}/extlinux" 
mkdir -p $RELEASE_DIR/3rdparty/bootloader

LINUX_DTS_DIR=$(get_build_dir linux)/.install_pkg/usr/share/bootloader
  for dtb in $RELEASE_DIR/3rdparty/bootloader/*.dtb; do

if [ ! -f $dtb ]; then
 continue
fi

cat << EOF > "${LE_TMP}/extlinux/$(basename ${dtb}).conf"
LABEL ${DISTRO}
  LINUX /${KERNEL_NAME}
  FDT /$(basename ${dtb})
  APPEND boot=UUID=@BOOT_UUID@ disk=UUID=@DISK_UUID@ quiet ${EXTRA_CMDLINE}
EOF

cp -a "${LE_TMP}/extlinux/$(basename ${dtb}).conf" $RELEASE_DIR/3rdparty/bootloader
done

# ★开机 splash★:initramfs 的 load_splash() 会依序找 /flash/oemsplash-<vres>.png、
# /flash/oemsplash-1080.png、/flash/oemsplash.png(见 packages/sysutils/busybox/
# scripts/init)。把图放进第一分区,开机跑码时就会被这张图盖住。
# 注意这跟 EmuELEC 的「开机影片」是两回事,开机影片可以独立关掉。
SPLASH_SRC="${PROJECT_DIR}/${PROJECT}/devices/${DEVICE}/splash/oemsplash-1080.png"
if [ -f "${SPLASH_SRC}" ]; then
  cp -a "${SPLASH_SRC}" $RELEASE_DIR/3rdparty/bootloader/oemsplash-1080.png
fi
